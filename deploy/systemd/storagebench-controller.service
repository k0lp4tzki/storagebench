# systemd unit for the storagebench controller.
#
# The controller does NOT need root. It only serves HTTP/WS and writes its
# SQLite database. Run it as a dedicated unprivileged user.
#
# Install:
#   sudo useradd --system --home /var/lib/storagebench --shell /usr/sbin/nologin storagebench
#   sudo mkdir -p /var/lib/storagebench /etc/storagebench
#   sudo chown -R storagebench:storagebench /var/lib/storagebench
#   sudo cp bin/storagebench-controller /usr/local/bin/
#   sudo cp configs/controller.example.json /etc/storagebench/controller.json   # then edit
#   # put the shared token in the environment file (root-only perms):
#   echo 'STORAGEBENCH_AGENT_TOKEN=change-me' | sudo tee /etc/storagebench/controller.env
#   sudo chmod 600 /etc/storagebench/controller.env
#   sudo cp deploy/systemd/storagebench-controller.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now storagebench-controller

[Unit]
Description=storagebench controller (coordinator + web UI)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=storagebench
Group=storagebench
EnvironmentFile=/etc/storagebench/controller.env
ExecStart=/usr/local/bin/storagebench-controller --config /etc/storagebench/controller.json
Restart=on-failure
RestartSec=3

# Hardening: the controller is unprivileged and sandboxed.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/storagebench
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
