# Build output
/bin/
/dist/
*.exe
*.test
*.out

# Go
/vendor/

# Runtime data
*.db
*.db-wal
*.db-shm
*.sqlite
/data/
/var/

# Node / web
/web/node_modules/
/web/dist/
/web/.vite/

# Built frontend embedded into the controller binary (generated by CI/Make).
# Keep only the placeholder index.html so go:embed always has something.
/cmd/controller/webdist/*
!/cmd/controller/webdist/index.html

# Editor / OS
.DS_Store
.idea/
.vscode/
*.swp
*~

# Logs
*.log
/logs/

# Local secrets / tokens (never commit real tokens)
*.token
secrets.*
config.local.*
.env
