# Copy to .env next to docker-compose.yml and adjust. .env is gitignored, so your
# settings survive a git pull.

# Pre-shared token agents must present to the controller.
STORAGEBENCH_AGENT_TOKEN=change-me-to-a-strong-token

# Host interface and port the controller is published on.
#   SB_BIND=127.0.0.1  -> only reachable on the controller host (default)
#   SB_BIND=0.0.0.0    -> reachable from other machines
SB_BIND=127.0.0.1
SB_PORT=8080
